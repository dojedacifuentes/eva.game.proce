  "description": "Juego educativo de Derecho Procesal chileno de Diego Ojeda · EVA / Proyecto01",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
